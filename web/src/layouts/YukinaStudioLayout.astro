---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4f8f8" />
    <title>{title}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem("aiimg-studio-theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.dataset.theme = savedTheme || (prefersDark ? "dark" : "light");

      if (
        new URLSearchParams(window.location.search).get("preview") === "1" &&
        !window.AstrBotPluginPage
      ) {
        const now = Math.floor(Date.now() / 1000);
        const responses = {
          get_config: {
            success: true,
            config: {
              providers: [
                { id: "gitee", label: "Gitee Images", model: "z-image-turbo", __template_key: "gitee_images" },
                { id: "agnes", label: "Agnes Video", model: "agnes-video-2.5-flash", __template_key: "agnes_video" },
                { id: "nai", label: "NovelAI", model: "nai-diffusion-4-5-full", __template_key: "nai_native" },
              ],
              features: {
                draw: { enabled: true, chain: [{ provider_id: "gitee" }] },
                edit: { enabled: true, chain: [{ provider_id: "gitee" }] },
                selfie: { enabled: true, chain: [{ provider_id: "gitee" }] },
                video: { enabled: true, chain: [{ provider_id: "agnes" }] },
              },
            },
          },
          get_studio_config: {
            success: true,
            revision: "preview-revision",
            config: {
              providers: [
                { id: "gitee", label: "Gitee Images", model: "z-image-turbo", __template_key: "gitee_images", api_keys: [], api_keys_configured: true },
                { id: "agnes", label: "Agnes Video", model: "agnes-video-2.5-flash", __template_key: "agnes_video", api_keys: [], api_keys_configured: true },
                { id: "nai", label: "NovelAI", model: "nai-diffusion-4-5-full", __template_key: "nai_native", api_keys: [], api_keys_configured: false },
              ],
              features: {
                draw: { enabled: true, llm_tool_enabled: true, presets: ["窗台小鸟:a small white bird on a windowsill"], chain: [{ provider_id: "gitee" }] },
                edit: { enabled: true, llm_tool_enabled: true, presets: [], chain: [{ provider_id: "nai" }] },
                selfie: { enabled: true, llm_tool_enabled: true, chain: [{ provider_id: "nai" }], use_edit_chain_when_empty: true },
                video: { enabled: true, llm_tool_enabled: true, presets: [], chain: [{ provider_id: "agnes" }] },
                studio: { enabled: true, default_entry: "create" },
              },
              storage: { max_cached_images: 100, max_cached_videos: 20 },
              network: { media_allow_private: false, max_image_bytes: 52428800, max_video_bytes: 52428800, max_redirects: 5, dns_resolve_timeout_seconds: 2 },
              reply_config: { draw_pending_message: "", selfie_pending_message: "", verbose_report: false },
              debounce_interval: 10,
              max_user_concurrency: 2,
              max_user_video_concurrency: 1,
              persona_config: { active_persona_id: "default", profiles: [] },
              astrbot_providers: [{ id: "preview-chat", model: "preview-model" }],
            },
          },
          get_provider_capabilities: {
            success: true,
            items: [
              {
                provider_id: "gitee", label: "Gitee Images", model: "z-image-turbo", template_key: "gitee_images", source: "template",
                protocol: { id: "gitee-images", last_verified: "2026-09-22" },
                operations: { image_generate: "supported", image_edit: "unsupported", video_generate: "unsupported" },
                references: { status: "unsupported", active_mode: "", modes: [] },
                parameters: { duration: { status: "unknown" }, aspect_ratios: { status: "unknown", values: [], default: "" }, sizes: { status: "unknown", values: [], default: "1024x1024" }, resolutions: { status: "unknown", values: [], default: "" } },
                streaming: { image_generate: "unsupported", image_edit: "unsupported", video_generate: "unsupported" },
                cancellation: { local: "supported", upstream: "unsupported" },
              },
              {
                provider_id: "agnes", label: "Agnes Video", model: "agnes-video-2.5-flash", template_key: "agnes_video", source: "template",
                protocol: { id: "agnes-videos-v1", last_verified: "2026-09-22" },
                operations: { image_generate: "unsupported", image_edit: "unsupported", video_generate: "supported" },
                references: { status: "supported", active_mode: "auto", modes: [{ id: "keyframe", label: "关键帧", status: "supported", min_images: 1, max_images: 1, accepted_media_types: ["image/jpeg", "image/png", "image/webp"] }, { id: "reference_images", label: "多图参考", status: "supported", min_images: 2, max_images: 5, accepted_media_types: ["image/jpeg", "image/png", "image/webp"] }] },
                parameters: { duration: { status: "supported", minimum: 4, maximum: 12, default: 5, unit: "seconds" }, aspect_ratios: { status: "supported", values: ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16"], default: "16:9" }, sizes: { status: "unknown", values: [], default: "" }, resolutions: { status: "unknown", values: [], default: "" } },
                streaming: { image_generate: "unsupported", image_edit: "unsupported", video_generate: "unsupported" },
                cancellation: { local: "supported", upstream: "unsupported" },
              },
              {
                provider_id: "nai", label: "NovelAI", model: "nai-diffusion-4-5-full", template_key: "nai_native", source: "template",
                protocol: { id: "novelai-native-compatible", last_verified: "2026-09-22" },
                operations: { image_generate: "supported", image_edit: "supported", video_generate: "unsupported" },
                references: { status: "supported", active_mode: "vibe", modes: [{ id: "img2img", label: "重绘", status: "supported", min_images: 1, max_images: 1, accepted_media_types: ["image/jpeg", "image/png", "image/webp"] }, { id: "vibe", label: "Vibe 参考", status: "supported", min_images: 1, max_images: 9, accepted_media_types: ["image/jpeg", "image/png", "image/webp"] }] },
                parameters: { duration: { status: "unknown" }, aspect_ratios: { status: "unknown", values: [], default: "" }, sizes: { status: "unknown", values: [], default: "832x1216" }, resolutions: { status: "unknown", values: [], default: "" } },
                streaming: { image_generate: "unsupported", image_edit: "unsupported", video_generate: "unsupported" },
                cancellation: { local: "supported", upstream: "unsupported" },
              },
            ],
          },
          get_tasks: {
            success: true,
            items: [
              { id: "T-2409", state: "generating", prompt: "薄雾森林中的白色长裙少女", created_at: now - 92, persona: "知更鸟", conversation: "私聊", generated: 1, sent: 0 },
              { id: "T-2408", state: "completed", prompt: "海面日落延时摄影", created_at: now - 620, persona: "默认人设", conversation: "创作群", generated: 1, sent: 1 },
            ],
          },
          get_jobs: {
            success: true,
            items: [],
          },
          get_history: {
            success: true,
            total: 4,
            items: [
              { id: 104, sequence: 1, created_at: now - 140, prompt: "玻璃温室里的午后光影", provider: "gitee", conversation_title: "灵感记录", available: false },
              { id: 103, sequence: 2, created_at: now - 900, prompt: "雨夜电车与霓虹倒影", provider: "nai", conversation_title: "私聊", available: false },
              { id: 102, sequence: 3, created_at: now - 1800, prompt: "浅滩珊瑚与热带鱼", provider: "gitee", conversation_title: "创作群", available: false },
              { id: 101, sequence: 4, created_at: now - 3600, prompt: "白色小鸟停在窗台", provider: "gitee", conversation_title: "灵感记录", available: false },
            ],
          },
          get_assets: {
            success: true,
            items: [
              { asset_id: "preview-asset-1", id: "preview-asset-1", scope: "preview-1", media_type: "image", filename: "午后窗台.png", created_at: now - 120, pinned: true, source: "upload" },
              { asset_id: "preview-asset-2", id: "preview-asset-2", scope: "preview-1", media_type: "image", filename: "珊瑚浅滩.png", created_at: now - 860, pinned: false, source: "upload" },
            ],
          },
          get_projects: {
            success: true,
            items: [
              { id: "preview-project-1", scope: "preview-1", name: "海边分镜", kind: "canvas", revision: 1, document: { version: 1, nodes: [] }, created_at: now - 1800, updated_at: now - 300 },
            ],
          },
          get_session_personas: {
            success: true,
            personas: [
              { id: "default", name: "默认助理" },
              { id: "robin", name: "知更鸟" },
            ],
            items: [
              { scope: "preview-1", origin: "aiocqhttp", bot: "知更鸟", conversation: "3325363511", title: "私聊", persona_id: "robin", effective_name: "知更鸟" },
              { scope: "preview-2", origin: "aiocqhttp", bot: "知更鸟", conversation: "creative-room", title: "创作群", persona_id: "", effective_name: "默认助理" },
            ],
          },
          get_studio_personas: {
            success: true,
            profiles: [
              { id: "robin", name: "知更鸟", base_prompt: "温柔、克制的舞台歌者", ref_images: [], ref_roles: {} },
            ],
          },
        };
        window.AstrBotPluginPage = {
          ready: async () => ({}),
          apiGet: async (name) => responses[name] || { success: false, error: "Preview endpoint unavailable" },
          apiPost: async () => ({ success: true }),
          download: async () => ({ success: true }),
        };
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
