{
  "agnes_video": {
    "name": "Agnes 视频",
    "items": {
      "id": {
        "type": "string",
        "description": "服务商 ID",
        "default": "agnes_video"
      },
      "base_url": {
        "type": "string",
        "description": "API 地址",
        "default": "https://apihub.agnes-ai.com/v1"
      },
      "api_keys": {
        "type": "list",
        "description": "API 密钥",
        "default": []
      },
      "model": {
        "type": "string",
        "description": "模型名称",
        "default": "agnes-video-2.5-flash"
      },
      "timeout": {
        "type": "int",
        "description": "请求超时（秒）",
        "default": 120
      },
      "max_retries": {
        "type": "int",
        "description": "最大重试次数",
        "default": 1
      },
      "poll_interval": {
        "type": "int",
        "description": "轮询间隔（秒）",
        "default": 2
      },
      "poll_timeout": {
        "type": "int",
        "description": "轮询超时（秒）",
        "default": 900
      },
      "seconds": {
        "type": "string",
        "description": "视频时长（秒）",
        "default": "5"
      },
      "aspect_ratio": {
        "type": "string",
        "description": "默认画幅",
        "default": "16:9",
        "options": [
          "16:9",
          "9:16",
          "1:1"
        ]
      },
      "image_handling_method": {
        "type": "string",
        "description": "图片处理方式",
        "default": "auto",
        "options": [
          "auto",
          "data_uri",
          "astrbot",
          "third_party",
          "free_public"
        ]
      },
      "file_service_base_url": {
        "type": "string",
        "description": "文件服务地址",
        "default": ""
      },
      "enable_file_service_magic": {
        "type": "bool",
        "description": "启用文件服务快捷配置",
        "default": true
      },
      "third_party_upload_url": {
        "type": "string",
        "description": "第三方上传地址",
        "default": ""
      },
      "third_party_token": {
        "type": "string",
        "description": "第三方上传凭据",
        "default": ""
      },
      "proxy_url": {
        "type": "string",
        "description": "代理地址",
        "default": ""
      }
    }
  },
  "openai_video": {
    "name": "OpenAI Videos",
    "items": {
      "id": {
        "type": "string",
        "description": "服务商 ID",
        "default": "openai_video"
      },
      "base_url": {
        "type": "string",
        "description": "API 地址",
        "default": "https://api.openai.com"
      },
      "api_keys": {
        "type": "list",
        "description": "API 密钥",
        "default": []
      },
      "model": {
        "type": "string",
        "description": "模型名称",
        "default": "sora-2"
      },
      "timeout": {
        "type": "int",
        "description": "请求超时（秒）",
        "default": 300
      },
      "max_retries": {
        "type": "int",
        "description": "最大重试次数",
        "default": 1
      },
      "poll_interval": {
        "type": "int",
        "description": "轮询间隔（秒）",
        "default": 10
      },
      "poll_timeout": {
        "type": "int",
        "description": "轮询超时（秒）",
        "default": 1200
      },
      "seconds": {
        "type": "string",
        "description": "视频时长（秒）",
        "default": "4"
      },
      "size": {
        "type": "string",
        "description": "默认尺寸",
        "default": "",
        "options": [
          "",
          "16:9",
          "9:16",
          "1:1",
          "4:3",
          "3:4",
          "1280x720",
          "720x1280"
        ]
      },
      "video_resolution": {
        "type": "string",
        "description": "视频分辨率",
        "default": "",
        "options": [
          "",
          "480p",
          "768p",
          "1080p"
        ]
      },
      "seed": {
        "type": "string",
        "description": "随机种子",
        "default": ""
      },
      "request_mode": {
        "type": "string",
        "description": "视频请求模式",
        "default": "auto",
        "options": [
          "auto",
          "json",
          "multipart"
        ]
      },
      "image_input_mode": {
        "type": "string",
        "description": "参考图输入模式",
        "default": "auto",
        "options": [
          "auto",
          "input_reference",
          "image_urls",
          "first_last_frame",
          "roles_reference",
          "roles_frames"
        ]
      },
      "input_reference_field": {
        "type": "string",
        "description": "文件参考图字段名",
        "default": "input_reference"
      },
      "max_download_mb": {
        "type": "int",
        "description": "最大下载大小（MB）",
        "default": 500
      },
      "extra_form": {
        "type": "string",
        "description": "额外请求字段（JSON）",
        "default": ""
      },
      "proxy_url": {
        "type": "string",
        "description": "代理地址",
        "default": ""
      }
    }
  },
