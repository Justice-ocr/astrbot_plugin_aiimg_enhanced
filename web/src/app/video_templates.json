  "xpivot_video": {
    "name": "Xpivot / Muse 视频（Grok 映射）",
    "items": {
      "id": {
        "type": "string",
        "description": "服务商 ID",
        "default": "xpivot_video"
      },
      "base_url": {
        "type": "string",
        "description": "API 地址",
        "default": "https://www.xpivot.top",
        "hint": "使用 /v1/video/generations 提交，完整任务端点轮询；根地址或带 /v1 均可。"
      },
      "api_keys": {
        "type": "list",
        "description": "API 密钥",
        "default": []
      },
      "model": {
        "type": "string",
        "description": "模型名称",
        "default": "grok-imagine-video-1.5"
      },
      "timeout": {
        "type": "int",
        "description": "请求超时（秒）",
        "default": 300
      },
      "poll_interval": {
        "type": "int",
        "description": "轮询间隔（秒）",
        "default": 5
      },
      "poll_timeout": {
        "type": "int",
        "description": "轮询超时（秒）",
        "default": 1200
      },
      "duration": {
        "type": "string",
        "description": "视频时长（秒）",
        "default": "5"
      },
      "aspect_ratio": {
        "type": "string",
        "description": "默认画幅",
        "default": "16:9",
        "options": [
          "16:9",
          "9:16",
          "1:1"
        ]
      },
      "xai_resolution": {
        "type": "string",
        "description": "视频分辨率",
        "default": "720p",
        "options": [
          "720p"
        ]
      },
      "xai_reference_mode": {
        "type": "string",
        "description": "参考图模式",
        "default": "reference",
        "options": [
          "reference",
          "image",
          "text"
        ],
        "hint": "自动参考：单张使用 image.url，2–7 张使用 reference_images；最多 7 张。"
      },
      "proxy_url": {
        "type": "string",
        "description": "代理地址",
        "default": ""
      }
    }
  }
}
