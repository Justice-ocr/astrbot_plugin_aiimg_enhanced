{
  "spicy_images": {
    "name": "SpicyAPI 图片 / 多图编辑",
    "description": "SpicyAPI createTask / recordInfo 异步图片协议；默认 Seedream 5.0 Flash，支持切换 Qwen 等模型。",
    "hint": "同一任务使用同一密钥；签名图片链接直接下载。修改模型时必须核对对应 input 参数与参考图上限。",
    "items": {
      "id": {
        "type": "string",
        "description": "服务商 ID（唯一）",
        "default": "spicy_images"
      },
      "label": {
        "type": "string",
        "description": "显示名称（可选）",
        "default": ""
      },
      "base_url": {
        "type": "string",
        "description": "SpicyAPI Base URL",
        "default": "https://api.spicyapi.ai",
        "hint": "填写站点根地址，不要填写 OpenAI /v1 路径。"
      },
      "api_keys": {
        "type": "list",
        "description": "API Key 池",
        "default": [],
        "obvious_hint": true,
        "hint": "每个任务始终使用创建时的同一密钥进行查询。"
      },
      "model": {
        "type": "string",
        "description": "文生图完整模型 ID",
        "default": "bytedance/seedream-5.0-flash/text-to-image",
        "hint": "从 SpicyAPI 模型目录复制完整 ID；文生图与改图是不同 ID。"
      },
      "edit_model": {
        "type": "string",
        "description": "改图完整模型 ID",
        "default": "bytedance/seedream-5.0-flash/edit"
      },
      "supports_edit": {
        "type": "bool",
        "description": "启用多参考图编辑",
        "default": true
      },
      "max_reference_images": {
        "type": "int",
        "description": "参考图上限",
        "default": 10,
        "hint": "Flash / Qwen 2.1 Turbo 为 10；切换其他模型时按其文档修改。"
      },
      "default_resolution": {
        "type": "string",
        "description": "默认分辨率",
        "default": "2k",
        "options": [
          "1k",
          "1.5k",
          "2k"
        ]
      },
      "aspect_ratio": {
        "type": "string",
        "description": "默认画面比例",
        "default": "auto",
        "options": [
          "auto",
          "1:1",
          "16:9",
          "9:16",
          "4:3",
          "3:4",
          "3:2",
          "2:3",
          "21:9",
          "9:21",
          "2:1",
          "1:2",
          "3:1",
          "1:3",
          "5:4",
          "4:5"
        ]
      },
      "extra_input": {
        "type": "text",
        "description": "额外 input 参数（JSON）",
        "default": "{}",
        "hint": "只填写当前模型支持的 input 字段。不能覆盖 prompt/image_urls。Qwen Turbo 可填写 {\"enable_prompt_expansion\":false,\"num_outputs\":1}。"
      },
      "timeout": {
        "type": "int",
        "description": "单次 HTTP 超时（秒）",
        "default": 120
      },
      "poll_interval": {
        "type": "int",
        "description": "任务查询间隔（秒）",
        "default": 3
      },
      "poll_timeout": {
        "type": "int",
        "description": "本地等待上限（秒）",
        "default": 600,
        "hint": "超时不取消远端任务；错误会保留 taskId。"
      },
      "proxy_url": {
        "type": "string",
        "description": "代理地址（可选）",
        "default": ""
      }
    }
  }
}
